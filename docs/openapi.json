  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "UuidInParams": {
        "in": "path",
        "name": "id",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
        }
      }
    },
    "schemas": {
      "BadRequestMessage": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "additionalProperties": false
      },
      "CreateUserRequest": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "email": {
            "example": "example@email.com",
            "type": "string",
            "format": "email",
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "password": {
            "example": "min 6 max 20",
            "type": "string",
            "minLength": 6,
            "maxLength": 20
          },
          "passwordConfirmation": {
            "example": "min 6 max 20",
            "type": "string",
            "minLength": 6,
            "maxLength": 20
          }
        },
        "required": [
          "email",
          "password",
          "passwordConfirmation"
        ],
        "additionalProperties": false
      },
      "AuthenticateUserRequest": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "email": {
            "example": "example@email.com",
            "type": "string",
            "format": "email",
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "password": {
            "example": "min 6 max 20",
            "type": "string",
            "minLength": 6,
            "maxLength": 20
          }
        },
        "required": [
          "email",
          "password"
        ],
        "additionalProperties": false
      },
      "TokenResponse": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "format": "jwt"
          }
        },
        "required": [
          "token"
        ],
        "additionalProperties": false
      },
      "Wallet": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "example": "e8434b44-5e82-4fb9-896e-67337eae2c6b",
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
          },
          "name": {
            "example": "Main Wallet",
            "type": "string"
          },
          "fgColor": {
            "example": "#FFFFFF",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "bgColor": {
            "example": "rgb(72,72,78)",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "sortOrder": {
            "description": "Optional manual order index. Must be a positive integer starting from 1.",
            "example": 1,
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false
      },
      "WalletList": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Wallet"
        }
      },
      "CreateWalletRequest": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "name": {
            "example": "Main Wallet",
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "fgColor": {
            "example": "#FFFFFF",
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "bgColor": {
            "example": "rgb(72,72,78)",
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "sortOrder": {
            "description": "Optional manual order index. Must be a positive integer starting from 1.",
            "example": 1,
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "UpdateWalletRequest": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "name": {
            "example": "Main Wallet",
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "fgColor": {
            "example": "#FFFFFF",
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "bgColor": {
            "example": "rgb(72,72,78)",
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "sortOrder": {
            "description": "Optional manual order index. Must be a positive integer starting from 1.",
            "example": 1,
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "additionalProperties": false
      },
      "Tag": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "example": "f210f03f-fdac-44d2-b98b-6e5a5805cef3",
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
          },
          "name": {
            "example": "Food",
            "type": "string"
          },
          "fgColor": {
            "example": "#48484e",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "bgColor": {
            "example": "rgba(255,255,255,0.82)",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false
      },
      "TagList": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Tag"
        }
      },
      "CreateTagRequest": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "name": {
            "example": "Food",
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "fgColor": {
            "example": "#48484e",
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "bgColor": {
            "example": "rgba(255,255,255,0.82)",
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "UpdateTagRequest": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "name": {
            "example": "Food",
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "fgColor": {
            "example": "#48484e",
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "bgColor": {
            "example": "rgba(255,255,255,0.82)",
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          }
        },
        "additionalProperties": false
      },
      "Expense": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "example": "147f8682-e1d6-4cb6-8226-b87709e12f4c",
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
          },
          "title": {
            "example": "Weekly grocery",
            "type": "string"
          },
          "description": {
            "examples": [
