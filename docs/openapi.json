        ]
      },
      "get": {
        "operationId": "getExpenses",
        "summary": "Retrieve expenses",
        "parameters": [
          {
            "in": "query",
            "name": "reference",
            "required": true,
            "description": "The reference date to start the period from.",
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2025-06-05"
            }
          },
          {
            "in": "query",
            "name": "period",
            "required": true,
            "description": "The period to retrieve expenses for.",
            "schema": {
              "type": "string",
              "enum": [
                "15d",
                "30d",
                "45d",
                "90d",
                "1m",
                "2m",
                "3m"
              ],
              "example": "3m"
            }
          }
        ],
        "description": "Retrieve expenses based on query parameters for reference date and period.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListExpensesResponse"
                }
              }
            }
          },
