{
  "name": "expense-tracker-api",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "lint": "run-s lint:check tscheck",
    "lint:check": "biome lint src",
    "lint:write": "biome lint --write src",
    "tscheck": "tsc --noEmit",
    "test": "NODE_ENV=test vitest run",
    "test:watch": "NODE_ENV=test vitest",
    "test:coverage": "NODE_ENV=test vitest run --coverage",
    "posttest:coverage": "npx http-server ./coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio --port 35353 --verbose",
    "build": "tsup",
    "prepare": "husky",
    "husky:pre-commit": "run-s lint test",
    "pkg:update": "npx npm-check-updates -i"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.4.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "drizzle-kit": "^0.31.4",
    "husky": "^9.1.7",
    "pino-pretty": "^13.1.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@fastify/autoload": "^6.3.1",
    "@fastify/compress": "^8.1.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "bcryptjs": "^3.0.2",
    "date-fns": "^4.1.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.44.5",
    "fastify": "^5.6.0",
    "jsonwebtoken": "^9.0.2",
    "npm-run-all": "^4.1.5",
    "pg": "^8.16.3",
    "pino": "^9.9.5",
    "tsup": "^8.5.0",
    "zod": "^4.1.8"
  }
}
