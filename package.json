{
  "name": "expense-tracker-api",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test:watch": "NODE_ENV=test vitest",
    "test": "run-s test:unit test:integration",
    "test:unit": "NODE_ENV=test vitest --dir ./src/features/ run",
    "pretest:integration": "NODE_ENV=test npm run db:migrate",
    "test:integration": "NODE_ENV=test vitest --dir ./src/infra/ run",
    "test:coverage": "vitest run --coverage",
    "posttest:coverage": "npx http-server ./coverage",
    "lint": "eslint src",
    "lint:fix": "npm run lint -- --fix",
    "dev": "tsx watch ./src/infra/index.ts",
    "docs:lint": "npx @redocly/cli lint ./docs/spec.yml",
    "db:generate": "drizzle-kit generate --config=./src/infra/db/config.ts",
    "db:migrate": "tsx ./src/infra/db/migrate.ts",
    "db:push": "drizzle-kit push --config=./src/infra/db/config.ts",
    "db:drop": "drizzle-kit drop --config=./src/infra/db/config.ts",
    "db:studio": "drizzle-kit studio --port 35353 --verbose --config=./src/infra/db/config.ts",
    "prepare": "husky",
    "husky:pre-commit": "run-s docs:lint lint test"
  },
  "devDependencies": {
    "@eslint/js": "^9.5.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.8",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@types/winston": "^2.4.4",
    "@vitest/coverage-v8": "^1.6.0",
    "drizzle-kit": "^0.22.8",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-drizzle": "^0.2.3",
    "eslint-plugin-import-x": "^0.5.1",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-simple-import-sort": "^12.1.0",
    "husky": "^9.1.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.3.2",
    "supertest": "^7.0.0",
    "tsx": "^4.15.7",
    "typescript": "^5.4.4",
    "typescript-eslint": "^7.13.1",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.31.2",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "postgres": "^3.4.4",
    "uuid": "^10.0.0",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  }
}