{
  "name": "expense-tracker-api",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch ./src/index.ts",
    "lint": "eslint src",
    "lint:fix": "npm run lint -- --fix",
    "pretest": "NODE_ENV=test npm run db:migrate:latest",
    "test": "NODE_ENV=test vitest --dir ./tests run",
    "test:watch": "NODE_ENV=test vitest --dir ./tests",
    "test:coverage": "NODE_ENV=test vitest run --coverage",
    "posttest:coverage": "npx http-server ./coverage",
    "docs:lint": "npx @redocly/cli lint ./docs/open-api/index.yml",
    "docs:bundle": "npx @redocly/cli bundle ./docs/open-api/index.yml -o ./docs/openapi.yml",
    "docs:include": "git add ./docs/openapi.yml",
    "docs": "run-s docs:lint docs:bundle docs:include",
    "knex": "NODE_OPTIONS='--import tsx/esm' ./node_modules/.bin/knex --knexfile ./src/db/config.ts",
    "db:migrate:make": "npm run knex -- migrate:make",
    "db:migrate:latest": "npm run knex -- migrate:latest",
    "db:migrate:rollback": "npm run knex -- migrate:rollback",
    "db:migrate:up": "npm run knex -- migrate:up",
    "db:migrate:down": "npm run knex -- migrate:down",
    "db:migrate:list": "npm run knex -- migrate:list",
    "db:migrate:production": "NODE_ENV=production knex migrate:latest --knexfile dist/db/config.js",
    "build:migrations": "tsc --project tsconfig.migrations.json",
    "build:app": "tsup src/index.ts --format esm --minify --dts --out-dir dist/app",
    "build": "run-p build:*",
    "prepare": "husky",
    "husky:pre-commit": "run-s lint docs test"
  },
  "devDependencies": {
    "@eslint/js": "^9.5.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/eslint__js": "^8.42.3",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/knex": "^0.15.2",
    "@types/node": "^22.15.1",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^3.1.4",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import-x": "^0.5.1",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-simple-import-sort": "^12.1.0",
    "husky": "^9.1.1",
    "npm-run-all": "^4.1.5",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.3.2",
    "supertest": "^7.0.0",
    "tsx": "^4.15.7",
    "typescript": "^5.4.4",
    "typescript-eslint": "^7.13.1",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^3.1.4"
  },
  "dependencies": {
    "app-root-path": "^3.1.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "decimal.js": "^10.5.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "pg": "^8.16.0",
    "pino": "^9.7.0",
    "pino-http": "^10.4.0",
    "tsup": "^8.5.0",
    "zod": "^3.23.8"
  }
}
